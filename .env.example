# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# For PostgreSQL (Production):
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=codebase_agent
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ============================================
# DJANGO SETTINGS
# ============================================
SECRET_KEY=django-insecure-change-this-in-production-xyz123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# OLLAMA LLM CONFIGURATION (FREE, LOCAL)
# ============================================
# Ollama API endpoint (default for local installation)
LLM_API_URL=http://localhost:11434

# Ollama model to use
# Recommended models:
# - qwen2.5-coder:7b (BEST for code analysis)
# - deepseek-coder:6.7b (Good for code)
# - llama3.1:8b (Good general model)
LLM_MODEL=qwen2.5-coder:7b

# API key (not needed for Ollama)
LLM_API_KEY=

# Max tokens (keep at 4096 for Ollama)
LLM_MAX_TOKENS=4096

# ============================================
# REPOSITORY STORAGE
# ============================================
# Where to clone repositories
REPO_STORAGE_PATH=/tmp/codebase_repos

# ============================================
# NOTES FOR SETUP
# ============================================
# 1. Install Ollama: https://ollama.com/download
# 2. Start Ollama: ollama serve
# 3. Pull model: ollama pull qwen2.5-coder:7b
# 4. Run Django: python manage.py runserver
# ============================================
